{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restore-the-fourth-scorecard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ACCESS_ISSUER": "",
    "ACCESS_AUDIENCE": "",
    "STAFF_ROLES": "{}",
    "AI_MODEL": "",
  },
  "env": {
    "staging": {
      "vars": {
        "ACCESS_ISSUER": "",
        "ACCESS_AUDIENCE": "",
        "STAFF_ROLES": "{}",
        "AI_MODEL": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "surveillance-scorecard-staging",
          "database_id": "1eeaa6f2-983e-4cc5-8fc7-27449033b022",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "vars": {
        "ACCESS_ISSUER": "",
        "ACCESS_AUDIENCE": "",
        "STAFF_ROLES": "{}",
        "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "surveillance-scorecard-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "surveillance-scorecard",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/scorecard", "/scorecard/*"],
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "none",
  },
}
